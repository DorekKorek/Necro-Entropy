{
  "configurations": [
    {
      "name": "Default",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "defines": [],
      "compilerPath": "g++",
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "linux-gcc-x64",
      "browse": {
        "path": [
          "${workspaceFolder}/**"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "linux": {
    "compilerPath": "/usr/bin/g++",
    "intelliSenseMode": "linux-gcc-x64",
    "includePath": [
      "${workspaceFolder}/**",
      "/usr/include"
    ]
  },
  "windows": {
    "compilerPath": "C:/msys64/ucrt64/bin/g++.exe",
    "intelliSenseMode": "windows-gcc-x64",
    "includePath": [
      "${workspaceFolder}/**",
      "C:/msys64/ucrt64/include/**"
    ]
  },
  "version": 4
}
