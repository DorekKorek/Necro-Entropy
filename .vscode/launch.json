{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Necro-Entropy",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/necroentropy",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "preLaunchTask": "build",
            "linux": {
                "program": "${workspaceFolder}/build/necroentropy",
                "miDebuggerPath": "/usr/bin/gdb"
            },
            "windows": {
                "program": "${workspaceFolder}/build/necroentropy.exe",
                "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
                "environment": [
                    {
                        "name": "PATH",
                        "value": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                    }
                ]
            },
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
