{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "g++ -std=c++20 -g -Wall -Wextra -fdiagnostics-color=always main.cpp sdl.cpp conway.cpp -o necroentropy $(pkg-config --cflags --libs sdl2 SDL2_mixer)",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build Necro-Entropy (g++, C++20, SDL2, SDL2_mixer)"
        }
    ]
}