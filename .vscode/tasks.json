{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "g++ -std=c++20 -g -Wall -Wextra -fdiagnostics-color=always main.cpp -o life $(pkg-config --cflags --libs sdl2)",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Build main.cpp with debug symbols and SDL3."
    }
  ]
}
